# Postgres connection string (matches docker-compose.yml's `postgres` service)
DATABASE_URI=postgresql://postgres:postgres@127.0.0.1:5432/xoxn

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash. On Railway it
# can stay unset: the app falls back to RAILWAY_PUBLIC_DOMAIN, which Railway sets.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Destructive: allows the seed (POST /next/seed), which wipes content and
# fills the site with the demo. Leave unset in production except
# deliberately, and unset it again afterward. `pnpm seed` locally doesn't need it.
# ALLOW_SEED=true

# The one Owner (superadmin) account. Created on startup if none exists (production
# included); a new email here moves the account to it on the next start; locally, `pnpm superadmin:reset` / `pnpm seed` re-assert it (reset
# password) for recovery. Password must be 12+ characters.
SUPERADMIN_EMAIL=YOUR_EMAIL_HERE
SUPERADMIN_PASSWORD=YOUR_STRONG_PASSWORD_HERE

# Proxies in front of the app that append to X-Forwarded-For, used by the
# sign-in and form rate limits. 1 = Railway's edge only; 2 = Cloudflare in front of it.
TRUSTED_PROXY_HOPS=1

# Railway Bucket (S3-compatible) media storage, production only. Leave all
# five unset locally so dev uploads keep landing on disk (see the README,
# Deploy). Set on the Railway app service, referencing the
# Bucket resource's variables.
# BUCKET=YOUR_BUCKET_NAME_HERE
# ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID_HERE
# SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY_HERE
# ENDPOINT=https://storage.railway.app
# REGION=auto

# Set to true on extra replicas so only one runs the background jobs.
# DISABLE_JOB_AUTORUN=true
